# Apache — front controller (ทำงานได้ทั้ง /omnichannel และ /rt/allchat)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # อย่า hardcode RewriteBase — ให้ใช้โฟลเดอร์ที่ติดตั้งจริง
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L]
</IfModule>

Options -Indexes
