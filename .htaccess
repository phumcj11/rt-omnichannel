# Apache (XAMPP) — rewrite ไปที่ index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /omnichannel/
    # ให้ไฟล์จริง (เช่น api/erp/index.php, assets) ทำงานก่อน
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
